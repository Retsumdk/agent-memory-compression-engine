{
  "name": "agent-memory-compression-engine",
  "version": "1.0.0",
  "description": "Deterministic agent-memory compression: redundancy clustering, extractive summaries, tiered append-only archive",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "agent",
    "memory",
    "compression",
    "deduplication",
    "clustering",
    "summarization",
    "simhash",
    "jaccard",
    "append-only",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "amce": "./dist/cli-main.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "bun test",
    "demo": "bun run src/cli-main.ts demo",
    "verify:demo": "bun run scripts/verify-demo.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Retsumdk/agent-memory-compression-engine.git"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
